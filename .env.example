# ---- AI (optional but recommended) ----
# Without a key the chat runs a transparent rule-based analyst over the same data tools.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Macro data (optional) ----
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html  (Fed Funds rate, CPI, PCE)
FRED_API_KEY=

# ---- Database (optional) ----
# If set, watchlist + analysis history are stored in PostgreSQL (tables auto-created).
# If empty, they are stored in the browser (localStorage).
DATABASE_URL=

# ---- Data mode ----
# live (default) = real free sources; failures show "Live data unavailable".
# demo = synthetic data, every value labelled DEMO DATA. Can also be switched in Settings.
DATA_MODE=live
